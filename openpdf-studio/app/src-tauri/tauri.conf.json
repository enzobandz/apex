{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPDF Studio",
  "version": "0.1.0",
  "identifier": "org.openpdfstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenPDF Studio",
        "width": 1320,
        "height": 860,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Free, open-source, offline PDF editor",
    "longDescription": "OpenPDF Studio views, annotates, fills, organizes, merges, splits, protects and optimizes PDF documents entirely on your computer. No accounts, no ads, no telemetry.",
    "copyright": "OpenPDF Studio contributors — MPL-2.0",
    "license": "MPL-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "name": "PDF Document",
        "description": "PDF document",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": { "depends": [] }
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
